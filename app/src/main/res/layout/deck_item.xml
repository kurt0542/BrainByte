<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    android:layout_marginVertical="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/deck_image"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/deck_item_background"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/deck_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="User created flashcard"
            android:textColor="@color/purple_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/deck_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/deck_image"
            android:layout_marginStart="16dp"/>

        <ImageView
            android:id="@+id/card_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_card"
            app:layout_constraintStart_toStartOf="@id/deck_name"
            app:layout_constraintTop_toBottomOf="@id/deck_name"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/deck_card_count_description"/>

        <TextView
            android:id="@+id/card_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15"
            android:textColor="@color/grey_text"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/card_icon"
            app:layout_constraintTop_toTopOf="@id/card_icon"
            app:layout_constraintBottom_toBottomOf="@id/card_icon"
            android:layout_marginStart="4dp"/>

        <ImageView
            android:id="@+id/time_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_time"
            app:layout_constraintStart_toEndOf="@id/card_count"
            app:layout_constraintTop_toTopOf="@id/card_icon"
            app:layout_constraintBottom_toBottomOf="@id/card_icon"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/deck_last_updated_description"/>

        <TextView
            android:id="@+id/last_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10min ago"
            android:textColor="@color/grey_text"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/time_icon"
            app:layout_constraintTop_toTopOf="@id/time_icon"
            app:layout_constraintBottom_toBottomOf="@id/time_icon"
            android:layout_marginStart="4dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
