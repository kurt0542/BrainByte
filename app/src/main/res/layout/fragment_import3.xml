<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_grey_background"
    tools:context=".ImportFragment3">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:paddingBottom="80dp">

        <!-- Header -->
        <TextView
            android:id="@+id/add_flashcard_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_flashcard_title"
            android:textColor="@color/purple_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"/>

        <!-- Deck Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/deck_info_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/purple_light"
            app:layout_constraintTop_toBottomOf="@id/add_flashcard_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_card"
                    app:tint="@color/purple_primary"
                    android:contentDescription="@null"/>

                <TextView
                    android:id="@+id/selected_deck_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/selected_deck_placeholder"
                    android:textColor="@color/purple_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/change_deck_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/change_deck"
                    android:textColor="@color/purple_primary"
                    android:textSize="12sp"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Deck Name Section -->
        <TextView
            android:id="@+id/deck_name_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/deck_name_label"
            android:textColor="@color/black_text"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/deck_info_card"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/deck_name_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/deck_name_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/deck_name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:padding="12dp"
                android:hint="@string/deck_name_hint"
                android:textColorHint="#9E9E9E"
                android:textColor="@color/black_text"
                android:textSize="15sp"
                android:background="@android:color/transparent"
                android:inputType="text"
                android:maxLines="1"
                android:autofillHints="none"/>

        </com.google.android.material.card.MaterialCardView>

        <!-- Card Counter and Bulk Import Row -->
        <TextView
            android:id="@+id/card_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/card_counter_placeholder"
            android:textColor="@color/grey_text"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/deck_name_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/btn_bulk_import"
            android:layout_marginTop="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_bulk_import"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/bulk_import"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="@color/purple_primary"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="@color/purple_primary"
            app:strokeWidth="1dp"
            app:cornerRadius="18dp"
            app:layout_constraintTop_toBottomOf="@id/deck_name_card"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"/>

        <!-- Front of Card Section -->
        <TextView
            android:id="@+id/front_card_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/front_of_card"
            android:textColor="@color/black_text"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/btn_bulk_import"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/front_card_input_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/front_card_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/front_card_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:padding="16dp"
                android:hint="@string/front_card_hint"
                android:textColorHint="#9E9E9E"
                android:textColor="@color/black_text"
                android:textSize="15sp"
                android:background="@android:color/transparent"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:autofillHints="none"/>

        </com.google.android.material.card.MaterialCardView>

        <!-- Back of Card Section -->
        <TextView
            android:id="@+id/back_card_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/back_of_card"
            android:textColor="@color/black_text"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/front_card_input_card"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/back_card_input_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/back_card_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/back_card_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:padding="16dp"
                android:hint="@string/back_card_hint"
                android:textColorHint="#9E9E9E"
                android:textColor="@color/black_text"
                android:textSize="15sp"
                android:background="@android:color/transparent"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:autofillHints="none"/>

        </com.google.android.material.card.MaterialCardView>

        <!-- Preview Card -->
        <TextView
            android:id="@+id/preview_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/preview_label"
            android:textColor="@color/black_text"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/back_card_input_card"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp"/>

        <!-- Preview Card Container -->
        <FrameLayout
            android:id="@+id/preview_card_container"
            android:layout_width="0dp"
            android:layout_height="180dp"
            app:layout_constraintTop_toBottomOf="@id/preview_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp">

            <!-- Front Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/preview_card_front"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/purple_primary">

                <LinearLayout
                    android:id="@+id/preview_front_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/preview_side_indicator_front"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/front_side"
                        android:textColor="#FFFFFF80"
                        android:textSize="12sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/preview_front_text"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="@string/preview_front_placeholder"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="8dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Back Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/preview_card_back"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#3949AB"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/preview_back_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/preview_side_indicator_back"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/back_side"
                        android:textColor="#FFFFFF80"
                        android:textSize="12sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/preview_back_text"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="@string/preview_back_placeholder"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:layout_marginTop="8dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <!-- Tap to flip hint -->
        <TextView
            android:id="@+id/flip_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tap_to_flip"
            android:textColor="@color/grey_text"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/preview_card_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

        <!-- Buttons Row -->
        <LinearLayout
            android:id="@+id/buttons_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/flip_hint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_another"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/add_another_card"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="@color/purple_primary"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/purple_primary"
                app:strokeWidth="2dp"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/purple_primary"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_card"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/save_card"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="@color/white"
                app:backgroundTint="@color/purple_primary"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/white"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

        <!-- Finish Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_finish"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="@string/finish_import"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:backgroundTint="#4CAF50"
            app:cornerRadius="28dp"
            app:layout_constraintTop_toBottomOf="@id/buttons_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
