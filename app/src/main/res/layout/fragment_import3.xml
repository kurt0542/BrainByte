<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_grey_background"
    tools:context=".ImportFragment3">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:paddingBottom="80dp">

        <!-- Header -->
        <TextView
            android:id="@+id/add_flashcard_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_flashcard_title"
            android:textColor="@color/purple_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"/>

        <!-- Deck Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/deck_info_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/purple_light"
            app:layout_constraintTop_toBottomOf="@id/add_flashcard_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_card"
                    app:tint="@color/purple_primary"
                    android:contentDescription="@null"/>

                <TextView
                    android:id="@+id/selected_deck_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/selected_deck_placeholder"
                    android:textColor="@color/purple_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/change_deck_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/change_deck"
                    android:textColor="@color/purple_primary"
                    android:textSize="12sp"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Deck Name Section -->
        <TextView
            android:id="@+id/deck_name_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/deck_name_label"
            android:textColor="@color/black_text"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/deck_info_card"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/deck_name_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/deck_name_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/deck_name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:padding="12dp"
                android:hint="@string/deck_name_hint"
                android:textColorHint="#9E9E9E"
                android:textColor="@color/black_text"
                android:textSize="15sp"
                android:background="@android:color/transparent"
                android:inputType="text"
                android:maxLines="1"
                android:autofillHints="none"/>

        </com.google.android.material.card.MaterialCardView>

        <!-- Card Counter Header -->
        <TextView
            android:id="@+id/card_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/card_counter_placeholder"
            android:textColor="@color/black_text"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/deck_name_card"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp"/>

        <!-- Flashcards List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/flashcards_recycler_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/card_counter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"/>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/empty_state_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/card_counter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_card"
                app:tint="@color/grey_text"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_flashcards_message"
                android:textColor="@color/grey_text"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

        <!-- Finish Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_finish"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="@string/finish_import"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:backgroundTint="#4CAF50"
            app:cornerRadius="28dp"
            app:layout_constraintTop_toBottomOf="@id/flashcards_recycler_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
