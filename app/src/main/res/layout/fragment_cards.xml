<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_grey_background"
    android:fillViewport="true"
    tools:context=".CardsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Flashcards Section Header -->
        <TextView
            android:id="@+id/flashcards_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/flashcards_title"
            android:textColor="@color/black_text"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/flashcards_view_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_all_text"
            android:textColor="@color/purple_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/flashcards_title"
            app:layout_constraintBottom_toBottomOf="@id/flashcards_title"/>

        <!-- Flashcards RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/flashcards_recycler_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/flashcards_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            tools:listitem="@layout/deck_item"
            tools:itemCount="2"/>

        <!-- Create New Flashcard Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/create_flashcard_btn"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:text="@string/create_new_flashcard_button"
            app:backgroundTint="@color/purple_primary"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_add"
            app:iconTint="@android:color/white"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:elevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/flashcards_recycler_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"/>

        <!-- Recently Viewed Section Header -->
        <TextView
            android:id="@+id/recently_viewed_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recently_viewed_title"
            android:textColor="@color/black_text"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/create_flashcard_btn"
            android:layout_marginTop="32dp"/>

        <TextView
            android:id="@+id/recently_viewed_view_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_all_text"
            android:textColor="@color/purple_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/recently_viewed_title"
            app:layout_constraintBottom_toBottomOf="@id/recently_viewed_title"/>

        <!-- Recently Viewed RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recently_viewed_recycler_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/recently_viewed_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:listitem="@layout/deck_item"
            tools:itemCount="2"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
