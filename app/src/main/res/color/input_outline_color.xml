<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: fully opaque -->
    <item android:state_focused="true" android:color="#FF613EEA"/>
    <!-- Hovered state: fully opaque -->
    <item android:state_hovered="true" android:color="#FF613EEA"/>
    <!-- Default: semi-transparent (50% alpha) -->
    <item android:color="#80613EEA"/>
</selector>
